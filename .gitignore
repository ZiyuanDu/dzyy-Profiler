# Ignore everything at the repository root unless explicitly included.
/*
!/.gitignore
!/.python-version
!/README.md
!/pyproject.toml
!/uv.lock

# Keep raw profiling reports and local experiments out of the repository.
/profiles/
*.nsys-rep
*.qdrep
*.qdstrm
*.ncu-rep
*.ncu-repz

# Keep troubleshooting documentation.
!/troubleshooting/
/troubleshooting/**
!/troubleshooting/**/
!/troubleshooting/**/*.md

# Keep the project icon used by the README.
!/assets/
/assets/*
!/assets/dzyy-profiler-icon.png

# Numbered lessons contain Markdown documentation and Python examples.
!/[0-9][0-9]-*/
/[0-9][0-9]-*/**
!/[0-9][0-9]-*/**/
!/[0-9][0-9]-*/**/*.md
!/[0-9][0-9]-*/**/*.py

# Publish only the final figures referenced by the lesson.
/01-GEMM/posts/*
!/01-GEMM/posts/001-gemm-output.png
!/01-GEMM/posts/002-gemm-tiles.gif
!/01-GEMM/posts/003-gemm-grid.png
!/01-GEMM/posts/004-elephant-pipeline.gif
!/01-GEMM/posts/005-cuda-details-cat.png
!/01-GEMM/posts/006-cuda-vibe-comparison.png
!/01-GEMM/posts/007-gemm-code-comparison.png
!/01-GEMM/posts/008-nsys-tilelang.png
!/01-GEMM/posts/009-nsys-pytorch.png
!/01-GEMM/posts/010-nsight-systems-icon.png
!/01-GEMM/posts/011-nsight-compute-icon.png
!/01-GEMM/posts/012-thank-you-nvidia.png
!/01-GEMM/posts/013-john-stone-nsys-copies.png
!/01-GEMM/posts/014-stephen-jones-ncu-analysis.jpg
!/01-GEMM/posts/015-nsys-command.svg
!/01-GEMM/posts/015-nsys-command.png

# Exclude local environments, caches, and settings inside lesson directories too.
.venv/
__pycache__/
.cache/
.ruff_cache/
.pytest_cache/
.tilelang/
.vscode/
.idea/
.agents/
.codex/
.aws/
.env
.env.*
